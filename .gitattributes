# Keep source archives free of machine-local and rebuildable state.
/.vscode export-ignore
/.vscode/** export-ignore
/.harness export-ignore
/.harness/** export-ignore
/dist export-ignore
/dist/** export-ignore
/tmp export-ignore
/tmp/** export-ignore
/wiki/_generated export-ignore
/wiki/_generated/** export-ignore
/error_book/_generated export-ignore
/error_book/_generated/** export-ignore
**/__pycache__ export-ignore
**/.pytest_cache export-ignore
**/.mypy_cache export-ignore
**/.ruff_cache export-ignore
**/*.py[cod] export-ignore
**/*.db export-ignore
**/*.sqlite export-ignore
**/*.sqlite3 export-ignore
**/*.sqlite-wal export-ignore
**/*.sqlite-shm export-ignore
**/*.sqlite3-wal export-ignore
**/*.sqlite3-shm export-ignore
/research/**/search-runs/raw export-ignore
/research/**/search-runs/raw/** export-ignore
/sources/papers/*.pdf export-ignore
/sources/papers/longlora-iclr-2024.pdf -export-ignore
