# Copy this file to .env.local and fill the values for one machine.
# .env.local is loaded automatically and excluded from Git.

# Review-first model profiles. This example uses the official DeepSeek endpoint.
HARNESS_FAST_MODEL=openai:deepseek-v4-flash
HARNESS_FAST_MODEL_BASE_URL=https://api.deepseek.com
HARNESS_FAST_API_KEY=
HARNESS_REASONING_MODEL=openai:deepseek-v4-pro
HARNESS_REASONING_MODEL_BASE_URL=https://api.deepseek.com
HARNESS_REASONING_API_KEY=

# Model request budgets. Increase the reasoning timeout for slower local servers.
HARNESS_FAST_MODEL_TIMEOUT_SECONDS=180
HARNESS_FAST_MODEL_MAX_RETRIES=2
HARNESS_REASONING_MODEL_TIMEOUT_SECONDS=300
HARNESS_REASONING_MODEL_MAX_RETRIES=2

# Multi-source discovery.
DEEPXIV_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Shared download/provider retries.
HARNESS_NETWORK_MAX_ATTEMPTS=3
HARNESS_NETWORK_CONNECT_TIMEOUT_SECONDS=20
HARNESS_NETWORK_READ_TIMEOUT_SECONDS=180
HARNESS_NETWORK_BACKOFF_SECONDS=2
HARNESS_NETWORK_MAX_BACKOFF_SECONDS=30

# Semantic Scholar is rate-limited independently from other providers.
HARNESS_S2_MAX_ATTEMPTS=6
HARNESS_S2_CONNECT_TIMEOUT_SECONDS=20
HARNESS_S2_READ_TIMEOUT_SECONDS=90
HARNESS_S2_BACKOFF_SECONDS=5
HARNESS_S2_MAX_BACKOFF_SECONDS=60
HARNESS_S2_REQUEST_INTERVAL_SECONDS=1.1
HARNESS_S2_RATE_LIMIT_BACKOFF_SECONDS=30
HARNESS_S2_COOLDOWN_SECONDS=300

# Legacy single-model path used by the Durable Loop.
HARNESS_MODEL=openai:deepseek-v4-flash
HARNESS_MODEL_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
HARNESS_MODEL_TIMEOUT_SECONDS=300
HARNESS_MODEL_MAX_RETRIES=2

HARNESS_WORKSPACE_ID=long-context-sparse-models
HARNESS_CONTEXT_TOKENS=6000
HARNESS_MAX_TOOL_ITERATIONS=6
HARNESS_TOOL_OUTPUT_CHARS=12000
LANGGRAPH_STRICT_MSGPACK=true

# Review CLI progress: auto (live on a terminal), live, plain, or off.
HARNESS_PROGRESS=auto

# These normally default to the current repository's .harness folder.
# Any writable drive is supported; override only for a separate data location.
# HARNESS_DB_PATH=C:/path/to/current-clone/.harness/research-harness.sqlite3
# TIKTOKEN_CACHE_DIR=C:/path/to/current-clone/.harness/tiktoken-cache

# PowerShell environment variables override matching values in .env.local.
# S2_API_KEY remains available as an alias for SEMANTIC_SCHOLAR_API_KEY.
