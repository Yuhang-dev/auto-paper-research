# Non-secret Harness configuration only. Keep API tokens in the current shell.
HARNESS_MODEL=openai:deepseek-v4-flash
OPENAI_API_BASE=https://api.deepseek.com
HARNESS_WORKSPACE_ID=long-context-sparse-models
HARNESS_CONTEXT_TOKENS=6000
HARNESS_MAX_TOOL_ITERATIONS=6
HARNESS_TOOL_OUTPUT_CHARS=12000
LANGGRAPH_STRICT_MSGPACK=true

# These normally default to the current repository's D-drive .harness folder.
# Set them only when an explicit D-drive override is needed.
# HARNESS_DB_PATH=D:/path/to/current-clone/.harness/research-harness.sqlite3
# TIKTOKEN_CACHE_DIR=D:/path/to/current-clone/.harness/tiktoken-cache

# OPENAI_API_KEY is the LangChain adapter variable for the DeepSeek key.
# Set OPENAI_API_KEY and DEEPXIV_TOKEN in the shell, not in this file.
