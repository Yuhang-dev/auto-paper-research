# Non-secret Harness configuration only. Keep API tokens in the current shell.
# Use the exact model ID exposed by the local server's /v1/models endpoint.
HARNESS_MODEL=openai:replace-with-served-model-id
HARNESS_MODEL_BASE_URL=http://127.0.0.1:8000/v1
HARNESS_WORKSPACE_ID=long-context-sparse-models
HARNESS_CONTEXT_TOKENS=6000
HARNESS_MAX_TOOL_ITERATIONS=6
HARNESS_TOOL_OUTPUT_CHARS=12000
LANGGRAPH_STRICT_MSGPACK=true

# These normally default to the current repository's D-drive .harness folder.
# Set them only when an explicit D-drive override is needed.
# HARNESS_DB_PATH=D:/path/to/current-clone/.harness/research-harness.sqlite3
# TIKTOKEN_CACHE_DIR=D:/path/to/current-clone/.harness/tiktoken-cache

# OPENAI_API_KEY is the credential for the configured OpenAI-compatible endpoint.
# Set OPENAI_API_KEY and DEEPXIV_TOKEN in the shell, not in this file.

# Review-first dual-model profiles. Fast handles planning/screening/skim;
# reasoning handles deep reading, evidence assessment, and synthesis.
# A standard review requires the complete HARNESS_REASONING_* trio unless
# --allow-single-model-fallback is explicitly supplied.
# HARNESS_FAST_MODEL=openai:replace-with-fast-served-model-id
# HARNESS_FAST_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# HARNESS_FAST_API_KEY=replace-in-shell-only
# HARNESS_REASONING_MODEL=openai:replace-with-reasoning-served-model-id
# HARNESS_REASONING_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# HARNESS_REASONING_API_KEY=replace-in-shell-only

# Multi-source review discovery. Keep all credentials in the current shell.
# DEEPXIV_TOKEN=replace-in-shell-only
# SEMANTIC_SCHOLAR_API_KEY=replace-in-shell-only
# S2_API_KEY is accepted as a compatibility alias.
# TAVILY_API_KEY=replace-in-shell-only
# GITHUB_TOKEN=optional-but-recommended

# DeepSeek-compatible alternative (the official endpoint remains V4 Flash only):
# HARNESS_MODEL=openai:deepseek-v4-flash
# HARNESS_MODEL_BASE_URL=https://api.deepseek.com
